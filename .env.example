# Copy these values into `.env` and adjust. Never commit `.env`.
# APP_ENV: dev on your machine, prod on a server.
APP_ENV=dev
# DATABASE_URL: prototype uses a local file database (used from Milestone 1).
DATABASE_URL=sqlite:///./saath.db
# META_API_KEY: leave empty to use the offline stub (used from Milestone 2).
META_API_KEY=
# MODEL_ID: pinned to the Standard tier. Never use a "-contributor" ID:
# Contributor-tier content may be used to train models.
MODEL_ID=muse-spark-1.3
MODEL_MODE=standard
# SESSION_TTL_HOURS: how long one login token stays valid.
SESSION_TTL_HOURS=24
# APPROVAL_TTL_HOURS: how long an approval request stays decidable.
APPROVAL_TTL_HOURS=24
# OUTBOX_DIR: where exported files land (used from Milestone 6).
OUTBOX_DIR=outbox
# WORKER_ENABLED: start the background deadline watcher with the server.
WORKER_ENABLED=true
# WORKER_INTERVAL_SECONDS: how often the worker scans for due reminders.
WORKER_INTERVAL_SECONDS=60
# AUTO_APPROVE_TOOLS: consequential tools that run without asking
# (comma-separated, e.g. export_calendar). Empty by default, meaning
# everything pauses for approval. Auto-approved runs are still written
# to the audit trail. Unknown names stop the server at startup.
AUTO_APPROVE_TOOLS=
# RUNWAYML_API_SECRET: Runway video key from https://dev.runwayml.com.
# Without it, video jobs refuse honestly. This is the only variable name.
RUNWAYML_API_SECRET=
# MEDIA_DIR: where video lesson files land (served only to their owner).
MEDIA_DIR=media
# FFMPEG_PATH / FFPROBE_PATH: explicit media tool paths. Leave empty to use PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# GOOGLE_CALENDAR_CLIENT_ID / _SECRET: Google Cloud Console OAuth client
# (Desktop app). Without both, calendar stays "missing" and Connect refuses.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_MAPS_API_KEY: Cloud Console API key restricted to Places API +
# Routes API. Billable per request (fractions of a cent); Saath also
# enforces GOOGLE_MAPS_DAILY_CAP locally (Cloud quotas stay authoritative).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DAILY_CAP=200
